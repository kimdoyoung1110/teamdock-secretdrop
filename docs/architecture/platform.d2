# Platform architecture — where each piece is built and hosted.
# Render: pnpm docs:diagrams
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 20
  }
}

classes: {
  card: {style: {fill: "#FFFFFF"; stroke: "#D9D5F0"; stroke-width: 2; border-radius: 16; shadow: true; font-size: 24; bold: true; font-color: "#17142B"}}
  card-kc: {style: {fill: "#FFFBF2"; stroke: "#F08C00"; stroke-width: 2; border-radius: 16; shadow: true; font-size: 24; bold: true; font-color: "#17142B"}}
  card-local: {style: {fill: "#FAFAFC"; stroke: "#ADB5BD"; stroke-width: 2; stroke-dash: 4; border-radius: 16; font-size: 24; bold: true; font-color: "#4A4666"}}
  logo: {shape: image; width: 56; height: 56; style: {font-size: 15; font-color: "#4A4666"; bold: false}}
  db: {shape: image; width: 72; height: 72; style: {font-size: 17; font-color: "#4A4666"}}
  person: {shape: person; style: {fill: "#F3F1FB"; stroke: "#5B3FD6"; font-size: 17}}
  deploy: {style: {stroke: "#5B3FD6"; stroke-width: 3; font-color: "#5B3FD6"; font-size: 16; bold: true}}
  traffic: {style: {stroke: "#17142B"; stroke-width: 3; font-size: 16; bold: true}}
  server: {style: {stroke: "#E03131"; stroke-width: 2; stroke-dash: 5; font-color: "#E03131"; font-size: 16; bold: true}}
  row: {style: {fill: transparent; stroke-width: 0}}
  spacer: {style: {opacity: 0}}
  data: {style: {stroke: "#868E96"; stroke-width: 2; stroke-dash: 5; font-color: "#4A4666"; font-size: 15}}
}

plat: "" {
  grid-rows: 4
  grid-columns: 3
  horizontal-gap: 190
  vertical-gap: 110
  style: {fill: transparent; stroke-width: 0}

  dev: "" {
    class: row
    grid-columns: 3
    horizontal-gap: 0
    l: "" {class: spacer}
    p: Developer {class: person}
    r: "" {class: spacer}
  }
  github: GitHub · pnpm monorepo {
    class: card
    grid-columns: 4
    horizontal-gap: 44
    gh: "main branch" {class: logo; icon: ./icons/github.svg}
    apps: "apps/teamdock\napps/secretdrop" {class: logo; icon: ./icons/nextdotjs.svg}
    infra: "infra/keycloak\nDockerfile · realm" {class: logo; icon: ./icons/keycloak.svg}
    compose: "infra/compose.dev.yml" {class: logo; icon: ./icons/docker.svg}
  }
  local: Local · docker compose {
    class: card-local
    grid-columns: 3
    horizontal-gap: 44
    kc: "Keycloak\n:8180" {class: logo; icon: ./icons/keycloak.svg}
    pg: "Postgres\n:5433" {class: logo; icon: ./icons/postgresql.svg}
    next: "next dev\n:9000 · :9001" {class: logo; icon: ./icons/nextdotjs.svg}
  }
  t1: "" {class: spacer; height: 70}
  user: "" {
    class: row
    grid-columns: 3
    horizontal-gap: 0
    l: "" {class: spacer}
    p: User / Grader {class: person}
    r: "" {class: spacer}
  }
  t2: "" {class: spacer; height: 70}
  vercel: Vercel · Hobby {
    class: card
    grid-columns: 3
    horizontal-gap: 44
    v: "auto deploy\non push" {class: logo; icon: ./icons/vercel.svg}
    td: "teamdock-sso\n.vercel.app" {class: logo; icon: ./icons/nextdotjs.svg}
    sd: "secretdrop-sso\n.vercel.app" {class: logo; icon: ./icons/nextdotjs.svg}
  }
  s1: "" {class: spacer}
  gcp: Google Cloud · us-east1 {
    class: card-kc
    grid-columns: 3
    horizontal-gap: 44
    g: "Cloud Run\nmin 0 · max 1" {class: logo; icon: ./icons/googlecloud.svg}
    ar: "Artifact Registry\nlinux/amd64 image" {class: logo; icon: ./icons/docker.svg}
    kc: "Keycloak 26\nrealm: teamdock" {class: logo; icon: ./icons/keycloak.svg}
  }
  s2: "" {class: spacer}
  neon: "" {
    class: row
    grid-columns: 3
    horizontal-gap: 0
    l: "" {class: spacer}
    db: "Neon Postgres · us-east-1\nkeycloak · teamdock · secretdrop" {class: db; icon: ./icons/neon.svg}
    r: "" {class: spacer}
  }
  s3: "" {class: spacer}
}

plat.dev.p -> plat.github: "git push" {class: deploy}
plat.github -> plat.vercel: "auto deploy on push to main\n(Root Directory per app)" {class: deploy}
plat.github -> plat.gcp: "docker buildx --push\ngcloud run deploy" {class: deploy}
plat.github -> plat.local: "pnpm infra:up" {class: deploy}

plat.user.p -> plat.vercel: "HTTPS" {class: traffic}
plat.user.p -> plat.gcp: "login redirect" {class: traffic}
plat.vercel <-> plat.gcp: "token exchange · JWKS\nBack-Channel Logout" {class: server}

plat.vercel -> plat.neon.db: "pooled" {class: data}
plat.gcp -> plat.neon.db: "direct" {class: data}
