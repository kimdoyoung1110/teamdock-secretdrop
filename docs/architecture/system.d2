# System architecture — runtime view: who talks to whom, and why.
# Render: pnpm docs:diagrams
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 20
  }
}

classes: {
  card: {style: {fill: "#FFFFFF"; stroke: "#D9D5F0"; stroke-width: 2; border-radius: 16; shadow: true; font-size: 24; bold: true; font-color: "#17142B"}}
  card-a: {style: {fill: "#FFFFFF"; stroke: "#17142B"; stroke-width: 2; border-radius: 16; shadow: true; font-size: 24; bold: true; font-color: "#17142B"}}
  card-b: {style: {fill: "#FFFFFF"; stroke: "#5B3FD6"; stroke-width: 2; border-radius: 16; shadow: true; font-size: 24; bold: true; font-color: "#5B3FD6"}}
  card-kc: {style: {fill: "#FFFBF2"; stroke: "#F08C00"; stroke-width: 2; border-radius: 16; shadow: true; font-size: 24; bold: true; font-color: "#17142B"}}
  row: {style: {fill: transparent; stroke-width: 0}}
  logo: {shape: image; width: 56; height: 56; style: {font-size: 15; font-color: "#4A4666"; bold: false}}
  db: {shape: image; width: 64; height: 64; style: {font-size: 16; font-color: "#4A4666"}}
  note: {style: {fill: transparent; stroke-width: 0; font-size: 16; font-color: "#4A4666"}}
  spacer: {style: {opacity: 0}}
  browser-flow: {style: {stroke: "#17142B"; stroke-width: 3; font-size: 17; font-color: "#17142B"; bold: true}}
  server-flow: {style: {stroke: "#E03131"; stroke-width: 2; stroke-dash: 5; font-size: 16; font-color: "#E03131"; bold: true}}
  api-flow: {style: {stroke: "#5B3FD6"; stroke-width: 3; font-size: 17; font-color: "#5B3FD6"; bold: true}}
  data-flow: {style: {stroke: "#C5C9D0"; stroke-width: 2}}
}

arch: "" {
  grid-rows: 5
  grid-columns: 3
  horizontal-gap: 200
  vertical-gap: 110
  style: {fill: transparent; stroke-width: 0}

  s1: "" {class: spacer}
  browser: Browser {
    class: card-a
    grid-columns: 3
    horizontal-gap: 44
    chrome: "Web app" {class: logo; icon: ./icons/googlechrome.svg}
    oidc: "OIDC redirect\nsession cookies" {class: logo; icon: ./icons/openid.svg}
    ts: "WebCrypto\nAES-256-GCM · PBKDF2" {class: logo; icon: ./icons/typescript.svg}
  }
  s2: "" {class: spacer}
  t1: "" {class: spacer; height: 90}
  t2: "" {class: spacer; height: 90}
  t3: "" {class: spacer; height: 90}
  teamdock: TeamDock · Service A {
    class: card
    grid-columns: 3
    horizontal-gap: 44
    next: "Next.js 16" {class: logo; icon: ./icons/nextdotjs.svg}
    ts: "TypeScript" {class: logo; icon: ./icons/typescript.svg}
    orm: "Drizzle ORM" {class: logo; icon: ./icons/drizzle.svg}
  }
  s3: "" {class: spacer}
  secretdrop: SecretDrop · Service B {
    class: card-b
    grid-columns: 3
    horizontal-gap: 44
    next: "Next.js 16" {class: logo; icon: ./icons/nextdotjs.svg}
    ts: "TypeScript" {class: logo; icon: ./icons/typescript.svg}
    orm: "Drizzle ORM" {class: logo; icon: ./icons/drizzle.svg}
  }
  db-td: "" {
    class: row
    grid-columns: 3
    horizontal-gap: 0
    l: "" {class: spacer}
    pg: "teamdock DB\nteams · team_members\nrevoked_sessions" {class: db; icon: ./icons/postgresql.svg}
    r: "" {class: spacer}
  }
  keycloak: Keycloak 26 · Identity Provider {
    class: card-kc
    grid-columns: 3
    horizontal-gap: 44
    kc: "realm: teamdock\n2 clients" {class: logo; icon: ./icons/keycloak.svg}
    oidc: "OIDC\nPKCE S256" {class: logo; icon: ./icons/openid.svg}
    jwt: "RS256 JWT\nJWKS" {class: logo; icon: ./icons/jsonwebtokens.svg}
  }
  db-sd: "" {
    class: row
    grid-columns: 3
    horizontal-gap: 0
    l: "" {class: spacer}
    pg: "secretdrop DB\nsecrets · access_logs\nrevoked_sessions" {class: db; icon: ./icons/postgresql.svg}
    r: "" {class: spacer}
  }
  s4: "" {class: spacer}
  db-kc: "" {
    class: row
    grid-columns: 3
    horizontal-gap: 0
    l: "" {class: spacer}
    pg: "keycloak DB\nusers · SSO sessions" {class: db; icon: ./icons/postgresql.svg}
    r: "" {class: spacer}
  }
  s5: "" {class: spacer}
}

arch.browser -> arch.teamdock: "① pages" {class: browser-flow}
arch.browser <-> arch.keycloak: "② OIDC login · Authorization Code + PKCE\nsession cookie reused → SSO" {class: browser-flow}
arch.browser -> arch.secretdrop: "③ pages · no login prompt\nuploads ciphertext only" {class: browser-flow}

arch.teamdock <-> arch.keycloak: "code → tokens (client secret)\n← Back-Channel Logout" {class: server-flow}
arch.secretdrop <-> arch.keycloak: "code → tokens (client secret)\n← Back-Channel Logout" {class: server-flow}
arch.secretdrop -> arch.teamdock: "④ GET /api/teams/me\nBearer access token (aud: teamdock)" {class: api-flow}

arch.teamdock -> arch.db-td.pg: {class: data-flow}
arch.keycloak -> arch.db-kc.pg: {class: data-flow}
arch.secretdrop -> arch.db-sd.pg: {class: data-flow}
