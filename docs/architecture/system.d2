# System architecture — runtime view: who talks to whom, and why.
# Render: pnpm docs:diagrams
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 30
  }
}
# 격자 배치: 1행 브라우저, 2행 Keycloak, 3행 두 서비스, 4행 서비스 DB.
classes: {
  client: {style: {fill: "#17142B"; stroke: "#17142B"; font-color: "#FFFFFF"; border-radius: 10; font-size: 22}}
  service: {style: {fill: "#F3F1FB"; stroke: "#5B3FD6"; stroke-width: 2; border-radius: 10; font-size: 22}}
  idp: {style: {fill: "#FFF4E0"; stroke: "#F08C00"; stroke-width: 2; border-radius: 10; font-size: 22}}
  store: {shape: cylinder; style: {fill: "#FFFFFF"; stroke: "#868E96"; font-size: 18}}
  browser-flow: {style: {stroke: "#17142B"; stroke-width: 3; font-size: 18; font-color: "#17142B"}}
  server-flow: {style: {stroke: "#4A4666"; stroke-width: 2; stroke-dash: 5; font-size: 17; font-color: "#4A4666"}}
  api-flow: {style: {stroke: "#5B3FD6"; stroke-width: 3; font-size: 18; font-color: "#5B3FD6"; bold: true}}
  logout-flow: {style: {stroke: "#E03131"; stroke-width: 2; stroke-dash: 5; font-size: 17; font-color: "#E03131"; bold: true}}
  data-flow: {style: {stroke: "#ADB5BD"; stroke-width: 2; font-size: 15}}
  spacer: {style: {opacity: 0}}
}

arch: "" {
  grid-rows: 4
  grid-columns: 3
  horizontal-gap: 280
  vertical-gap: 150
  style: {fill: transparent; stroke-width: 0}

  s1: "" {class: spacer}
  browser: "Browser\n\ncookies: KEYCLOAK_SESSION\nteamdock.session · secretdrop.session\n\nWebCrypto: AES-256-GCM, PBKDF2\nkey stays in URL #fragment" {class: client}
  db-kc: "keycloak DB\nusers\nSSO sessions" {class: store}

  s3: "" {class: spacer}
  keycloak: "Keycloak 26\nIdentity Provider\n\nrealm: teamdock\nclients: teamdock, secretdrop\nPKCE S256 · RS256 keys (JWKS)" {class: idp}
  s2: "" {class: spacer}

  teamdock: "TeamDock — Service A\nNext.js + Auth.js\n\nteams · invites · members\nGET /api/teams/me\nPOST /api/backchannel-logout" {class: service}
  s4: "" {class: spacer}
  secretdrop: "SecretDrop — Service B\nNext.js + Auth.js\n\nciphertext only · burn after read\nteam-only secrets · access log\nPOST /api/backchannel-logout" {class: service}

  db-td: "teamdock DB\nteams · team_members\nrevoked_sessions" {class: store}
  s5: "" {class: spacer}
  db-sd: "secretdrop DB\nsecrets · access_logs\nrevoked_sessions" {class: store}
}

arch.browser -> arch.teamdock: "① pages" {class: browser-flow}
arch.browser <-> arch.keycloak: "② OIDC login (Authorization Code + PKCE)\nsession cookie reused → SSO" {class: browser-flow}
arch.browser -> arch.secretdrop: "③ pages, no login prompt\nuploads ciphertext only" {class: browser-flow}

arch.teamdock <-> arch.keycloak: "code → tokens (client secret)\nBack-Channel Logout ←" {class: logout-flow}
arch.secretdrop <-> arch.keycloak: "code → tokens (client secret)\nBack-Channel Logout ←" {class: logout-flow}
arch.secretdrop -> arch.teamdock: "④ GET /api/teams/me\nBearer access token (aud: teamdock)" {class: api-flow}

arch.teamdock -> arch.db-td: {class: data-flow}
arch.keycloak -> arch.db-kc: {class: data-flow}
arch.secretdrop -> arch.db-sd: {class: data-flow}
